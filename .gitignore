# HRFCO histories are large (about 2 MB per station-year set for 1H, 4 MB for 10M); raw JSON and the manifest let them
# be rebuilt. Only the Miho River reference set stays tracked so the Osong twin works from a GitHub checkout.
data/processed/hrfco/*.csv
!data/processed/hrfco/waterlevel_3011665_1H.csv
!data/processed/hrfco/waterlevel_3011635_1H.csv
!data/processed/hrfco/waterlevel_3011685_1H.csv
!data/processed/hrfco/rainfall_30114070_1H.csv
