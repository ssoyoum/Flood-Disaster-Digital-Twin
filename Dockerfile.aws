FROM node:22-alpine AS frontend-build
WORKDIR /web
COPY package.json package-lock.json ./
RUN npm ci
COPY index.html tsconfig.json tsconfig.app.json vite.config.ts ./
COPY src ./src
COPY public ./public
ENV VITE_API_BASE=same-origin
RUN npm run build

FROM python:3.12-slim
WORKDIR /app
COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/app ./backend/app
COPY data/processed/osong ./data/processed/osong
COPY data/processed/seoul_2022 ./data/processed/seoul_2022
COPY --from=frontend-build /web/dist ./dist
ENV PYTHONPATH=/app/backend \
    FLOODOPS_STATIC_DIR=/app/dist
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
