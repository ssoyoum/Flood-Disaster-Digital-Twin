FROM node:22-alpine AS frontend-build
WORKDIR /web
COPY package.json package-lock.json ./
RUN npm ci
COPY index.html tsconfig.json tsconfig.app.json vite.config.ts ./
COPY src ./src
COPY public ./public
ENV VITE_API_BASE=same-origin
# Analytics and Search Console are off unless these build args are passed, e.g.
# docker build --build-arg VITE_GA4_ID=G-XXXX --build-arg VITE_META_PIXEL_ID=123 --build-arg VITE_GSC_VERIFICATION=token ...
ARG VITE_GA4_ID=""
ARG VITE_META_PIXEL_ID=""
ARG VITE_GSC_VERIFICATION=""
ARG VITE_PRIVACY_CONTACT=""
ENV VITE_GA4_ID=$VITE_GA4_ID VITE_META_PIXEL_ID=$VITE_META_PIXEL_ID VITE_GSC_VERIFICATION=$VITE_GSC_VERIFICATION VITE_PRIVACY_CONTACT=$VITE_PRIVACY_CONTACT
RUN npm run build

FROM python:3.12-slim
WORKDIR /app
COPY backend/requirements.txt ./requirements.txt
# LightGBM (6-hour rise model) needs OpenMP at runtime.
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir -r requirements.txt
COPY backend/app ./backend/app
COPY data/processed/osong ./data/processed/osong
COPY data/processed/seoul_2022 ./data/processed/seoul_2022
COPY data/processed/pohang_2022 ./data/processed/pohang_2022
COPY data/processed/andong_uiseong_2026 ./data/processed/andong_uiseong_2026
COPY data/models ./data/models
COPY --from=frontend-build /web/dist ./dist
ENV PYTHONPATH=/app/backend \
    FLOODOPS_STATIC_DIR=/app/dist
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
