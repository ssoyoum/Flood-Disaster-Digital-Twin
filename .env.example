VITE_API_BASE=http://localhost:8033
DATABASE_URL=postgresql+psycopg://floodops:REPLACE_ME@localhost:5432/floodops
POSTGRES_PASSWORD=REPLACE_ME

# Optional. Enables the LLM intent planner; without it the Agent uses the deterministic planner.
ANTHROPIC_API_KEY=REPLACE_ME

# Optional. Seconds before the LLM planner gives up and the deterministic planner
# answers instead. Keep it small on an untrusted venue network. Default: 10.
AGENT_LLM_TIMEOUT_SECONDS=10
